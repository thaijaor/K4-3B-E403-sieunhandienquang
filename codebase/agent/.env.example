# Chép thành .env (đã gitignore). Key Gemini dùng qua endpoint tương thích OpenAI.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Bearer key giữa BE và agent; để trống khi chạy local.
SERVICE_API_KEY=

# Mặc định ../app/lessons.sample.json
LESSONS_FILE=

# SQLite của Persona. Mặc định codebase/agent/data/agent.sqlite (đã gitignore)
AGENT_DB=
